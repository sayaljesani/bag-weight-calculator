<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/primary_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/load_subtitle"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_next_seq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/field"
            android:padding="12dp"
            android:textColor="@color/primary_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- resume banner -->
        <LinearLayout
            android:id="@+id/resume_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@color/banner"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_resume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_resume"
                    style="?android:attr/buttonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/resume" />

                <Button
                    android:id="@+id/btn_discard"
                    style="?android:attr/buttonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:text="@string/discard" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/FieldLabel" android:text="@string/count" />

        <EditText
            android:id="@+id/et_count"
            style="@style/Field"
            android:hint="@string/count_hint"
            android:inputType="textCapCharacters"
            android:autofillHints="" />

        <TextView style="@style/FieldLabel" android:text="@string/lot_no" />

        <EditText
            android:id="@+id/et_lot"
            style="@style/Field"
            android:hint="@string/lot_hint"
            android:inputType="textCapCharacters"
            android:autofillHints="" />

        <TextView style="@style/FieldLabel" android:text="@string/vehicle_no" />

        <EditText
            android:id="@+id/et_vehicle"
            style="@style/Field"
            android:hint="@string/vehicle_hint"
            android:inputType="textCapCharacters"
            android:autofillHints="" />

        <TextView style="@style/FieldLabel" android:text="@string/no_of_bags" />

        <EditText
            android:id="@+id/et_bags"
            style="@style/Field"
            android:hint="@string/bags_hint"
            android:inputType="number"
            android:autofillHints="" />

        <TextView style="@style/FieldLabel" android:text="@string/tare_weight" />

        <EditText
            android:id="@+id/et_tare"
            style="@style/Field"
            android:hint="@string/tare_hint"
            android:inputType="numberDecimal"
            android:autofillHints="" />

        <TextView style="@style/FieldLabel" android:text="@string/date" />

        <EditText
            android:id="@+id/et_date"
            style="@style/Field"
            android:hint="@string/date_hint"
            android:inputType="text"
            android:autofillHints="" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:background="@color/primary"
            android:text="@string/start_weighing"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_history"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/past_loads" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

    </LinearLayout>
</ScrollView>
